# yaml-language-server: $schema=https://json.schemastore.org/github-workflow.json
#
# =============================================================================
# E2E (__VERSION__) — end-to-end tests against version __VERSION__
# =============================================================================
# Runs the repository's E2E suite (mise task ci:e2e, with E2E_VERSION=__VERSION__)
# on merge_group, pull_request and pushes to main. One caller file per version,
# so each version gets its own status badge.
# Requires the mise task: ci:e2e.
#
# MANAGED BY E2E SYNC (axnic/.github, e2e.sync.yaml) — do not edit or rename by hand.
# Reusable workflow: https://github.com/axnic/.github/blob/main/.github/workflows/e2e.run.yaml
# =============================================================================

name: E2E (__VERSION__)

on:
  merge_group: {}
  pull_request: {}
  push:
    branches: [main]

concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

# Minimal top-level permissions — each job declares what it needs.
permissions: {}

jobs:
  e2e:
    name: 🧪 E2E (__VERSION__)
    # Intentionally not pinned: follows the latest axnic/.github (owner-controlled repo).
    uses: axnic/.github/.github/workflows/e2e.run.yaml@main
    with:
      version: __VERSION__
    secrets: inherit
    permissions:
      contents: read
