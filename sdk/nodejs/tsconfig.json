{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "api.ts",
        "apiClientGrant.ts",
        "applicationConfiguration.ts",
        "applicationImage.ts",
        "config/index.ts",
        "config/vars.ts",
        "getOidcClient.ts",
        "getOpenIdConfiguration.ts",
        "getUser.ts",
        "getUserGroup.ts",
        "index.ts",
        "oidcClient.ts",
        "oidcClientSecret.ts",
        "provider.ts",
        "scimServiceProvider.ts",
        "signupToken.ts",
        "types/enums/index.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "user.ts",
        "userCustomClaims.ts",
        "userGroup.ts",
        "userGroupCustomClaims.ts",
        "userGroupMembers.ts",
        "utilities.ts"
    ]
}
